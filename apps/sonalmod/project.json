{
  "name": "sonalmod",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["install-deps"],
      "inputs": ["default", "golangci"],
      "options": {
        "command": "make lint",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make test",
        "cwd": "{projectRoot}"
      }
    },
    "install-deps": {
      "cache": true,
      "options": {
        "command": "go mod download",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "make dist/bin",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "dependsOn": ["install-deps"],
      "options": {
        "command": "go run ./cmd/sonalmod start --json-logs | pino-pretty",
        "cwd": "{projectRoot}"
      }
    }
  }
}
