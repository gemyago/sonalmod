{
  "name": "skills",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["default", "golangci"],
      "options": {
        "command": "make lint",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make test",
        "cwd": "{projectRoot}"
      }
    }
  }
}
